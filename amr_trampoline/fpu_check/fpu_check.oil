OIL_VERSION = "2.5";

/* Kiem tra build hard-float + luu ngu canh FPU tren Trampoline stm32f407.
 * CHI BUILD, chua nap (board Hiwonder chua ve, target tam = stm32f4discovery).
 * 2 task cung dung float, task cao (fast) cat ngang task thap (slow) giua
 * luc dang tinh -> neu kernel khong luu s0-s31 thi ket qua cua slow sai. */

IMPLEMENTATION trampoline {
  TASK { UINT32 STACKSIZE = 512 ; } ;
  ISR  { UINT32 STACKSIZE = 256 ; } ;
};

CPU fpu_check {
  OS config {
    STATUS = EXTENDED;
    BUILD = TRUE {
      /* duong dan tuong doi: amr_ws/amr_trampoline/fpu_check -> Documents/trampoline */
      TRAMPOLINE_BASE_PATH = "../../../trampoline";
      APP_SRC = "fpu_check.c";
      APP_NAME = "fpu_check_exe";
      CFLAGS  = "-O2";
      LDFLAGS = "-Map=fpu_check.map";
      COMPILER = "arm-none-eabi-gcc";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = PYTHON;
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };

  APPMODE std {};

  TASK slow {
    PRIORITY = 1;
    AUTOSTART = TRUE { APPMODE = std; };
    ACTIVATION = 1;
    SCHEDULE = FULL;
    USEFLOAT = TRUE;
  };

  TASK fast {
    PRIORITY = 2;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
    USEFLOAT = TRUE;
  };

  ALARM fast_alarm {
    COUNTER = SystemCounter;
    ACTION = ACTIVATETASK { TASK = fast; };
    AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 1; CYCLETIME = 1; };
  };
};
