From bb20df1a9a9b09bba83c21a3819ee2c5ebf053ec Mon Sep 17 00:00:00 2001
From: tnguyenmanht-arch <tnguyenmanht@gmail.com>
Date: Wed, 30 Sep 2026 09:05:16 +0700
Subject: [PATCH 2/2] stm32f407: hard float + luu ngu canh FPU theo task
 (USEFLOAT)

Port cach lam cua stm32l432: -mfloat-abi=hard, process_specific template
sinh arm_float_context cho task/ISR USEFLOAT, startup tat ASPEN/LSPEN va
bat CP10/11 (luon bat khi build hard-float).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../stm32f407/process_specific.goilTemplate   | 45 +++++++++++++++++++
 .../armv7em/stm32f407/buildOptionsTarget.oil  |  7 +--
 .../armv7em/stm32f407/startup_stm32f4xx.c     | 13 ++++++
 3 files changed, 62 insertions(+), 3 deletions(-)
 create mode 100644 goil/templates/code/cortex-m/armv7em/stm32f407/process_specific.goilTemplate

diff --git a/goil/templates/code/cortex-m/armv7em/stm32f407/process_specific.goilTemplate b/goil/templates/code/cortex-m/armv7em/stm32f407/process_specific.goilTemplate
new file mode 100644
index 0000000..d510115
--- /dev/null
+++ b/goil/templates/code/cortex-m/armv7em/stm32f407/process_specific.goilTemplate
@@ -0,0 +1,45 @@
+%
+if exists proc::STACKSIZE then
+
+  let use_float := false
+  foreach sisr in ISRS do
+    if sisr::USEFLOAT then
+      let use_float := true
+    end if
+  end foreach
+  foreach tsk in TASKS do
+    if tsk::USEFLOAT then
+      let use_float := true
+    end if
+  end foreach
+
+%/*
+ * % !proc::KIND % % !proc::NAME % stack
+ */
+#define APP_% !proc::KIND %_% !proc::NAME %_START_SEC_STACK
+#include "tpl_memmap.h"
+VAR(tpl_stack_word, OS_APPL_DATA) % !proc::NAME %_stack_zone[% !proc::STACKSIZE %/sizeof(tpl_stack_word)];
+#define APP_% !proc::KIND %_% !proc::NAME %_STOP_SEC_STACK
+#include "tpl_memmap.h"
+
+#define % !proc::NAME %_STACK {% !proc::NAME %_stack_zone, % !proc::STACKSIZE %}
+
+/*
+ * % !proc::KIND % % !proc::NAME % context
+ */
+#define OS_START_SEC_VAR_NOINIT_32BIT
+#include "tpl_memmap.h"
+VAR(arm_core_context, OS_VAR) % !proc::NAME %_int_context;%
+if use_float then
+  if exists proc::USEFLOAT default(false) then %
+VAR(arm_float_context, OS_VAR) % !proc::NAME %_fp_context;
+#define % !proc::NAME %_CONTEXT { &% !proc::NAME %_int_context, &% !proc::NAME %_fp_context }%
+  else % 
+#define % !proc::NAME %_CONTEXT { &% !proc::NAME %_int_context, NULL }%
+  end if
+else %
+#define % !proc::NAME %_CONTEXT &% !proc::NAME %_int_context%
+end if %
+#define OS_STOP_SEC_VAR_NOINIT_32BIT
+#include "tpl_memmap.h"
+%end if #proc::STACKSIZE
\ No newline at end of file
diff --git a/goil/templates/config/cortex-m/armv7em/stm32f407/buildOptionsTarget.oil b/goil/templates/config/cortex-m/armv7em/stm32f407/buildOptionsTarget.oil
index 2fe28cd..e669b2c 100755
--- a/goil/templates/config/cortex-m/armv7em/stm32f407/buildOptionsTarget.oil
+++ b/goil/templates/config/cortex-m/armv7em/stm32f407/buildOptionsTarget.oil
@@ -1,17 +1,18 @@
 /*
  * ARMv7 build options for gcc - CortexM4
- * TODO: we use only soft FPU for now!
+ * amr_ws patch: hard float (giong stm32l432). Task/ISR dung float phai khai
+ * USEFLOAT = TRUE trong OIL de kernel luu s0-s31 + FPSCR khi chuyen ngu canh.
  */
 CPU buildOptions {
   BUILDOPTIONS buildForCortexM4 {
     COMMONFLAGS = "-mcpu=cortex-m4";              // Compile for cortex-m4
     COMMONFLAGS = "-mthumb";                      // Thumb instruction set
-    COMMONFLAGS = "-mfloat-abi=soft";             // Floating point numbers are computed in software
+    COMMONFLAGS = "-mfloat-abi=hard";             // Floating point numbers are computed by hardware
     COMMONFLAGS = "-mfpu=fpv4-sp-d16";            // FPU version for CortexM4
 
     ASFLAGS = "-mcpu=cortex-m4";                  // Assemble for cortex-m4
     ASFLAGS = "-mthumb";                          // Thumb instruction set
-    ASFLAGS = "-mfloat-abi=soft";                 // Floating point numbers are computed in software
+    ASFLAGS = "-mfloat-abi=hard";                 // Floating point numbers are computed by hardware
     ASFLAGS = "-mfpu=fpv4-sp-d16";                // FPU version for CortexM4
   };
 };
diff --git a/machines/cortex-m/armv7em/stm32f407/startup_stm32f4xx.c b/machines/cortex-m/armv7em/stm32f407/startup_stm32f4xx.c
index 2b5f733..58c15f5 100644
--- a/machines/cortex-m/armv7em/stm32f407/startup_stm32f4xx.c
+++ b/machines/cortex-m/armv7em/stm32f407/startup_stm32f4xx.c
@@ -1,4 +1,5 @@
 #include <sys/types.h>
+#include "stm32f4xx.h"  /* amr_ws patch: FPU, SCB, __FPU_USED (qua core_cm4.h) */
 
 void __attribute__((weak)) tpl_continue_reset_handler(void);
 
@@ -119,6 +120,18 @@ void __attribute__ ((section(".after_vectors"))) tpl_continue_reset_handler(void
   // Zero fill the bss segment
   bss_init(&__bss_start__, &__bss_end__);
 
+  // start FPU (amr_ws patch, chep tu startup_stm32l432.c)
+  // Bat CP10/11 moi khi build hard-float (khong phu thuoc WITH_FLOAT): neu
+  // khong, lenh VFP dau tien (ke ca trong libc/HAL) gay UsageFault NOCP.
+  #if (__FPU_PRESENT == 1) && (__FPU_USED == 1)
+    /* Khong tu dong stack thanh ghi FP khi vao ngat: Trampoline tu luu
+     * s0-s31 cho task co USEFLOAT. Phai cau hinh 2 bit nay TRUOC khi bat
+     * CP10/11 (ARMv7-M ARM DDI 0403E.e, B.3.2.21). */
+    FPU->FPCCR &= ~(1 << FPU_FPCCR_ASPEN_Pos | 1 << FPU_FPCCR_LSPEN_Pos);
+    /* set CP10 and CP11 Full Access */
+    SCB->CPACR |= ((3UL << 10*2)|(3UL << 11*2));
+  #endif
+
   // Call the standard library initialisation (mandatory, SystemInit()
   // and C++ static constructors are called from here).
   __libc_init_array();
-- 
