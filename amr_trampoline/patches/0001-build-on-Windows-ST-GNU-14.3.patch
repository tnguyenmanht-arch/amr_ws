From f9391b59e781081d69ead297b84dfe3598ea12b9 Mon Sep 17 00:00:00 2001
From: tnguyenmanht-arch <tnguyenmanht@gmail.com>
Date: Wed, 30 Sep 2026 09:03:05 +0700
Subject: [PATCH 1/2] build on Windows + ST GNU 14.3

- make.py: goil --target= thay cho -t= (goil Windows khong nhan -t= khi goi tu Python)
- startup stm32f407: bo goi _exit (ld moi tu choi BL toi symbol dia chi _exit = .)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 goil/templates/build/make_py.goilTemplate               | 4 ++--
 machines/cortex-m/armv7em/stm32f407/startup_stm32f4xx.c | 6 +++++-
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/goil/templates/build/make_py.goilTemplate b/goil/templates/build/make_py.goilTemplate
index 5529f90..7ac134f 100755
--- a/goil/templates/build/make_py.goilTemplate
+++ b/goil/templates/build/make_py.goilTemplate
@@ -72,7 +72,7 @@ except ImportError:
 	#it defines inline the red color, as other are defined in the makefile.py
 	print("\033[91mThe OS->BUILD->TRAMPOLINE_BASE_PATH key is not set correctly in the oil file % !OILFILENAME %.")
 	print("Set the correct Trampoline installation path in the oil file and run goil again:\033[0m")
-	print("goil -t=%!TARGET% --templates=%!TEMPLATEPATH% %!OILFILENAME%")
+	print("goil --target=%!TARGET% --templates=%!TEMPLATEPATH% %!OILFILENAME%")
 	sys.exit(1)
 
 #--- To work with relative paths
@@ -103,7 +103,7 @@ make = makefile.Make(goal)
 oilFile = "% !OILFILENAME %"
 oilFileDep = "build/" + oilFile + ".dep"
 oilCompiler = "goil"
-oilFlags = ["-t=% !TARGET %"%
+oilFlags = ["--target=% !TARGET %"%
 if exists TEMPLATEPATH then
   if TEMPLATEPATH != "" then
 %, "--templates=% !TEMPLATEPATH %"%
diff --git a/machines/cortex-m/armv7em/stm32f407/startup_stm32f4xx.c b/machines/cortex-m/armv7em/stm32f407/startup_stm32f4xx.c
index e1ab6ed..2b5f733 100644
--- a/machines/cortex-m/armv7em/stm32f407/startup_stm32f4xx.c
+++ b/machines/cortex-m/armv7em/stm32f407/startup_stm32f4xx.c
@@ -132,7 +132,11 @@ void __attribute__ ((section(".after_vectors"))) tpl_continue_reset_handler(void
   // On test platforms, like semihosting, this can be used to inform
   // the host on the test result.
   // On embedded platforms, usually reset the processor.
-  _exit(r);
+  /* amr_ws patch: binutils moi (ST GNU 14.3) tu choi BL toi _exit vi script.ld
+   * dinh nghia _exit = . (symbol dia chi, khong phai ham). StartOS() khong bao
+   * gio tra ve nen cho nay khong chay toi; treo tai cho thay vi goi _exit. */
+  (void)r;
+  for (;;) {}
 
 }
 
-- 
2.54.0.windows.1

